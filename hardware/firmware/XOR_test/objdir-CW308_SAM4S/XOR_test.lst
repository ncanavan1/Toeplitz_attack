 152:XOR_test.c    **** /*
 153:XOR_test.c    **** //https://github.com/Swati-Verma671/Computation-of-DFT-using-Radix-2-DIT-FFT-algorithm/blob/main/co
 154:XOR_test.c    **** void DIT_FFT(float complex *X, int N){
 155:XOR_test.c    ****     int s = round(log2(N));
 156:XOR_test.c    ****     reverse_array(X,N,s);
 157:XOR_test.c    ****     for(int stage=1; stage <= s; stage++){
 158:XOR_test.c    ****         int p = 0;
 159:XOR_test.c    ****         int q = 0 + pow(2,stage-1);
 160:XOR_test.c    ****         int n = 0;
 161:XOR_test.c    ****         while (n<=pow(2,(stage-1))-1 && q <=N)
 162:XOR_test.c    ****         {
 163:XOR_test.c    ****             float complex w = cexp(-2*I*PI*n/(pow(2,stage)));
 164:XOR_test.c    **** 
 165:XOR_test.c    ****             float complex y = X[p];
 166:XOR_test.c    ****             float complex z = X[q];
 167:XOR_test.c    **** 
 168:XOR_test.c    **** 
 169:XOR_test.c    ****             trigger_high();
 170:XOR_test.c    **** 
 171:XOR_test.c    ****             //for(int i = 0; i < 20; i++){
 172:XOR_test.c    ****               //__asm__ volatile ("nop");
 173:XOR_test.c    ****             //}
 174:XOR_test.c    **** 
 175:XOR_test.c    ****             z *= w;
 176:XOR_test.c    ****             X[p] = y+z;
 177:XOR_test.c    ****             X[q] = y-z;
 178:XOR_test.c    **** 
 179:XOR_test.c    **** 
 180:XOR_test.c    ****             //for(int i = 0; i < 20; i++){
 181:XOR_test.c    ****               //__asm__ volatile ("nop");
 182:XOR_test.c    ****             //}
 183:XOR_test.c    **** 
 184:XOR_test.c    ****             trigger_low();
 185:XOR_test.c    **** 
 186:XOR_test.c    ****             p++;
 187:XOR_test.c    ****             q++;
 188:XOR_test.c    ****             n++;
 189:XOR_test.c    ****             if(q % (int)pow(2,stage) == 0){
 190:XOR_test.c    ****                 p = p + pow(2,stage-1);
 191:XOR_test.c    ****                 q = q + pow(2,stage-1);
 192:XOR_test.c    ****                 n=0;
 193:XOR_test.c    ****             }
 194:XOR_test.c    ****         }
 195:XOR_test.c    ****     }
 196:XOR_test.c    **** }
 197:XOR_test.c    **** */
