  11:floating_point_multiply_test.c **** /* Blocking read of a line from stdin (UART) into buffer */
  12:floating_point_multiply_test.c **** static int read_line(char *buf, int maxlen) {
  13:floating_point_multiply_test.c ****     int i = 0;
  14:floating_point_multiply_test.c ****     int c;
  15:floating_point_multiply_test.c ****     while (i < maxlen - 1) {
  16:floating_point_multiply_test.c ****         c = getchar();
  17:floating_point_multiply_test.c ****         if (c == EOF) return -1;
  18:floating_point_multiply_test.c ****         buf[i++] = (char)c;
  19:floating_point_multiply_test.c ****         if (c == '\n') break;
  20:floating_point_multiply_test.c ****     }
  21:floating_point_multiply_test.c ****     buf[i] = '\0';
  22:floating_point_multiply_test.c ****     return i;
  23:floating_point_multiply_test.c **** }
